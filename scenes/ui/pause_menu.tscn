[ext_resource type="Theme" path="res://assets/ui/menu_theme.tres" id="2_theme"]

[node name="PauseMenu" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
