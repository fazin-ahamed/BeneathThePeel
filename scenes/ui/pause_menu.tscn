theme_override_colors/font_color = Color(0.65, 0.66, 0.72, 1)
theme_override_font_sizes/font_size = 6
text = "The thumping continues without you."
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Root/Center/Panel/Margin/Content"]
